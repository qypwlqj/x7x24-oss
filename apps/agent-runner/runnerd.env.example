# /opt/x7x24-agent/runnerd.env（root:x7runner 640）。不要提交真实值。
# 生产请绑定私有网卡地址；本地开发可用 127.0.0.1
RUNNER_BIND=127.0.0.1
RUNNER_PORT=8790
# 与后端 AGENT_RUNNER_HMAC_KEY 相同；用 `openssl rand -hex 32` 生成
RUNNER_HMAC_KEY=
RUNNER_IMAGE=x7x24-agent:claude
RUNNER_WORK=/opt/x7x24-agent/jobs
RUNNER_CACHE=/opt/x7x24-agent/cache
# 只含模型提供商令牌（root:x7runner 640）；docker CLI 读取后注入容器
RUNNER_ENV_FILE=/opt/x7x24-agent/model.env
# 逐行审查：open-code-review v1.13.5（先运行 install-ocr.sh 安装并校验）
#RUNNER_OCR_BIN=/opt/x7x24-agent/bin/ocr-v1.13.5
#RUNNER_OCR_WORK=/opt/x7x24-agent/ocr
#RUNNER_OCR_KEEP_DAYS=7
