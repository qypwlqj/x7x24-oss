# 7x24 Java 后端：全部通过环境变量配置（不要将凭据写入受版本管理的文件）
PORT=8787
DATA_DIR=./data                 # H2 文件库目录；或 DATABASE_URL=jdbc:postgresql://... + DATABASE_USER/PASSWORD
WEB_DIR=./no-web               # Java 仅提供 API；前端由 Next.js 运行

# Next.js：构建时设置，默认同源 /api 转发到本地 Java。前端默认端口 5173。
API_PROXY_TARGET=http://127.0.0.1:8787
NEXT_PUBLIC_API_BASE=           # 可选：直连独立后端的公开地址；留空则使用同源代理
NEXT_PUBLIC_BASE_PATH=          # 可选：部署子路径，如 /7x24；默认根路径，修改后重新构建

# offline（默认，不触网）| real（真实 GitHub）。real 下 ADAPTER_DRY_RUN 默认 true，设 false 才会真正写入
ADAPTER_MODE=offline
ADAPTER_DRY_RUN=true
GITHUB_TOKEN=                   # 可选：“服务器环境提供”的令牌；界面里连接的账号（授权登录/粘贴令牌）优先，且不可在界面删除本项
# 登录授权同时用于仓库发现；设备码流程需在 GitHub App 中开启 Enable Device Flow
GITHUB_OAUTH_CLIENT_ID=   # GitHub App 的 Client ID；需在 App 设置里勾选 Enable Device Flow
GITHUB_APP_SLUG=                # GitHub App 的 slug，用于管理仓库授权
GITHUB_APP_ID=                  # 后台安装身份：GitHub App ID（已配置 Client ID 时可省略）
GITHUB_APP_PRIVATE_KEY=         # 后台安装身份：RSA 私钥 PEM，可使用字面量 \n；只保存在服务端环境变量中
# GitHub App Setup URL：<后端公开地址>/api/auth/github/setup，接收安装/组织审批回调
X7_SECRET_KEY=                  # 可选：令牌加密主密钥（任意长度口令，SHA-256 派生）；不设置则在 DATA_DIR 下生成随机密钥文件（权限 600）
GITHUB_API_URL=https://api.github.com
TARGET_REPO=
TARGET_BASE_BRANCH=main
TARGET_WORKFLOW=ci.yml
INTAKE_LABEL=7x24:signal        # 带此标签的 open Issue 会被抓取为需求；INTAKE_ALL=true 则抓取所有 open Issue
RELEASE_PREFIX=x7x24
CI_TIMEOUT_SEC=1200
PROMETHEUS_URL=                 # 可选

# 不配置 LLM 时使用规则型 agent（确定性，支持有限模板）
# 配置 LLM（OpenAI 兼容，如 DeepSeek）后改用 LLM agent；详见 docs/llm.md。LLM_API_KEY 只放环境变量
LLM_BASE_URL=                   # 例如 https://api.deepseek.com （自动拼 /chat/completions，/v1 写法也可）
LLM_API_KEY=
LLM_MODEL=                      # 例如 deepseek-chat
LLM_CHEAP_MODEL=
LLM_JUDGE_MODELS=               # 评审席位 model[@温度]，逗号分隔，≥2 个且不全等于 LLM_MODEL；末席兼任仲裁
LLM_TEMPERATURE=
LLM_TIMEOUT_SEC=
LLM_MAX_RETRIES=
LLM_MAX_CONCURRENCY=
LLM_MIN_INTERVAL_MS=
LLM_PRICE_IN_PER_1M=            # 估算单价 USD/百万 token（可调占位值，非官方报价）
LLM_PRICE_OUT_PER_1M=

TICK_MS=2000                    # 引擎调度间隔
INTAKE_MS=30000                 # Issue 抓取间隔
OBSERVE_HOURS=-1                # 发布后观察窗口（小时），<0 用治理配置

# 通知：系统统一发信；用户在“个人通知设置”中验证收件邮箱。留空时仍可使用站内通知。
NOTIFICATION_APP_URL=           # 用户可访问的前端地址，如 https://your-app.example.com（不带 hash 或查询参数）
NOTIFICATION_FROM=              # 发件地址，需得到所用发信服务的授权
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=     # 服务商要求的 SMTP 授权凭据，只放部署环境变量
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_SMTP_SSL=false     # 使用 465 端口的隐式 TLS 时设 true，STARTTLS 自动关闭
NOTIFICATION_WORKER_ENABLED=true

# Authentication stays enabled; use your own GitHub App and explicit operator identities.
X7_AUTH_REQUIRED=true
X7_ALLOWED_GITHUB_LOGINS=
X7_PLATFORM_ADMINS=
X7_LEGACY_WORKSPACE_OWNER=
X7_PUBLIC_URL=
X7_ALLOWED_ORIGINS=

# Learning MVP: collection is separate from opt-in paid optimization. No rollout without independent tests.
LEARNING_ENABLED=false
LEARNING_MODEL_ENABLED=false
LEARNING_DAILY_USD=2
LEARNING_MAX_CALL_USD=0.25
LEARNING_MIN_EVALUATION_CASES=20
LEARNING_PROJECT_DELAY_MS=60000
# Dedicated offline test image, pinned as registry/image@sha256:<64 hex digits>.
LEARNING_DOCKER_IMAGE=
LEARNING_TEST_COMMAND=
LEARNING_TEST_TIMEOUT_SECONDS=30

# Remote agent runner (optional). Bind runnerd to a private interface; never 0.0.0.0.
# AGENT_RUNTIME=remote-docker
# AGENT_RUNNER_URL=http://127.0.0.1:8790
# AGENT_RUNNER_HMAC_KEY=

